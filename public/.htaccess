# Keep .htaccess minimal for HKUST shared hosting.
# Avoid Options/Header/ForceType directives that can trigger HTTP 500.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^services/?$ /#solutions [R=301,L,NE]
  RewriteRule ^contact/?$ /#contact [R=301,L,NE]
  RewriteRule ^customization/?$ /#capabilities [R=301,L,NE]
  RewriteRule ^platforms/?$ /#solutions [R=301,L,NE]
  RewriteRule ^projects/?$ /#research [R=301,L,NE]
</IfModule>
